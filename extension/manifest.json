{
  "manifest_version": 3,
  "name": "ChatGPT Windows Bridge",
  "version": "0.2.0",
  "description": "Review explicitly marked ChatGPT tasks, run constrained workspace operations on Windows, and relay actual results.",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatGPT Windows Bridge"
  }
}
