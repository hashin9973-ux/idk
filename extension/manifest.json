{
  "manifest_version": 3,
  "name": "ChatGPT Windows Bridge",
  "version": "0.2.0",
  "description": "Attaches a collapsible chat overlay to a ChatGPT tab, mirrors the conversation, and sends messages through ChatGPT.",
  "permissions": [
    "nativeMessaging",
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatGPT Windows Bridge"
  }
}
